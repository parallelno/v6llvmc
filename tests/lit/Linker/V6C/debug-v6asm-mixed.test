# RUN: rm -rf %t && mkdir -p %t && split-file %s %t
# RUN: clang -target i8080-unknown-v6c -g -O0 -fno-v6c-auto-include -c %t/c-entry.c -o %t/c-entry.o
# RUN: %v6asm -g -f obj %t/asm-leaf.asm -o %t/asm-leaf.o
# RUN: lld -flavor gnu -m elf32v6c -e c_entry -o %t/mixed.elf %t/c-entry.o %t/asm-leaf.o
# RUN: llvm-readelf -S -s %t/mixed.elf | FileCheck %s --check-prefix=ELF
# RUN: llvm-readelf -x .debug_line -x .debug_line_str %t/mixed.elf | FileCheck %s --check-prefix=LINES
# RUN: llvm-readelf -r %t/mixed.elf | FileCheck %s --check-prefix=RELOCS

# ELF-DAG: .debug_info
# ELF-DAG: .debug_abbrev
# ELF-DAG: .debug_line
# ELF-DAG: .debug_str
# ELF-DAG: c_entry
# ELF-DAG: asm_leaf

# LINES-DAG: 2d656e74 72792e63
# LINES-DAG: 00010061 736d2d6c
# LINES-DAG: 6561662e 61736d00

# RELOCS: There are no relocations in this file.

#--- c-entry.c
extern unsigned char asm_leaf(void);

unsigned char c_entry(void) {
  return asm_leaf() + 1;
}

#--- asm-leaf.asm
.text
.globl asm_leaf
asm_leaf:
  mvi a, 7
  ret